<Layouts.app flash={@flash}>
  <section id="home-hero" class="space-y-10">
    <div class="space-y-4">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-balance leading-[1.05]">
        See exactly what your webhook sent.
      </h1>
      <p class="text-lg opacity-75 max-w-prose text-pretty">
        Create a bin, point any service at its URL, and read every request as it arrives:
        method, headers and body, byte for byte. Bins last 7 days.
      </p>
    </div>

    <.form for={%{}} action={~p"/bins"} method="post" id="create-bin-form">
      <.button id="create-bin-button" class="btn btn-primary btn-lg">
        Create bin
      </.button>
    </.form>

    <figure aria-label="Example of a captured request" class="space-y-2">
      <pre
        phx-no-curly-interpolation
        class="rounded-box bg-base-200 border border-base-300 p-5 text-sm leading-relaxed overflow-x-auto"
      ><code><span class="font-semibold text-primary">POST</span> /h/7Qx2…/payments HTTP/1.1
<span class="opacity-60">content-type:</span> application/json
<span class="opacity-60">stripe-signature:</span> t=1761650000,v1=5257a8…
<span class="opacity-60">user-agent:</span> Stripe/1.0

{"type": "payment_intent.succeeded", "amount": 4200}</code></pre>
      <figcaption class="text-sm opacity-60">
        A request as it appears in your bin.
      </figcaption>
    </figure>
  </section>
</Layouts.app>
